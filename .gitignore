# Sheet rasters, intermediates, and outputs are far too large for git. The
# folders themselves are tracked (each holds a README explaining what goes in
# it) but nothing inside them is.
data/*
!data/sheets/
data/sheets/*
!data/sheets/README.md
work/*
!work/README.md
output/*
!output/README.md

# Belt and braces: these never belong in the repo, wherever they turn up.
*.tif
*.tif.aux.xml
*.vrt
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

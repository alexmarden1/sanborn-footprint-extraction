# Sheet rasters, intermediates, and outputs are far too large for git. Nothing
# you put under data/ is tracked - only the empty folder itself, so that a fresh
# clone has somewhere obvious to put sheets. See docs/SHEETS.md.
data/*
!data/sheets/
data/sheets/*
!data/sheets/.gitkeep
calibration/
work/*
!work/README.md
output/*
!output/README.md

# Belt and braces: these never belong in the repo, wherever they turn up.
*.tif
*.tif.aux.xml
*.vrt
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Personal run scripts holding machine-specific paths
*.local.cmd
*.local.ps1
*.local.sh

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

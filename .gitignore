# Sheet rasters, intermediates, and outputs are far too large for git, and the
# data folder is yours alone - nothing under it is tracked. See docs/SHEETS.md
# for what belongs there. work/ and output/ keep a README each, since the
# scripts create those folders themselves.
data/
calibration/
work/*
!work/README.md
output/*
!output/README.md

# Belt and braces: these never belong in the repo, wherever they turn up.
*.tif
*.tif.aux.xml
*.vrt
*.geojson
*.shp
*.shx
*.dbf
*.prj
*.cpg

# Personal run scripts holding machine-specific paths
*.local.cmd
*.local.ps1
*.local.sh

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
